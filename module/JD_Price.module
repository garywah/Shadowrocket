#!name=JD_Price
#!desc=京東比價，僅支持京東的標準模式，點擊商品詳情即可查看。
#!author=@wf021325
#!UpdateTime=2025-07-11
#首次使用請打開【慢慢買】APP，點擊【我的】，提示【獲取ck成功🎉】即可正常比價

[Script]

JD_Price = type=http-response, pattern=^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js, requires-body=true, max-size=-1, timeout=60
JD_Price = type=http-request, pattern=^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$, script-path=https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js, requires-body=true, max-size=-1, timeout=60

[MITM]

hostname = %APPEND% in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com